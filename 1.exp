import heapq

# Goal state
goal = "12345678_"

# Manhattan Distance Heuristic
def manhattan(state):
    distance = 0
    for idx, value in enumerate(state):
        if value != "_":
            goal_idx = goal.index(value)
            x1, y1 = divmod(idx, 3)
            x2, y2 = divmod(goal_idx, 3)
            distance += abs(x1 - x2) + abs(y1 - y2)
    return distance

# Possible moves
moves = {
    0: [1, 3],
    1: [0, 2, 4],
    2: [1, 5],
    3: [0, 4, 6],
    4: [1, 3, 5, 7],
    5: [2, 4, 8],
    6: [3, 7],
    7: [4, 6, 8],
    8: [5, 7]
}

# A* Search
def solve_puzzle(start):
    pq = []
    heapq.heappush(pq, (manhattan(start), 0, start, ""))
    visited = set()

    while pq:
        est_cost, cost, state, path = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)

        if state == goal:
            return path, cost

        blank = state.index("_")

        for move in moves[blank]:
            new_state = list(state)
            new_state[blank], new_state[move] = new_state[move], new_state[blank]
            new_state = "".join(new_state)

            if new_state not in visited:
                heapq.heappush(pq, (cost + 1 + manhattan(new_state),
                                    cost + 1, new_state, path + " -> " + new_state))

    return None, None


# Convert your input to state string
# 1, 6, 5,
# 7, 3, 8,
# 4, 2, _
start_state = "16573842_"

solution, steps = solve_puzzle(start_state)

print("Initial State:", start_state)
print("Goal State   :", goal)
print("\nSteps to reach goal:")
print(solution)
print("\nTotal Steps:", steps)
