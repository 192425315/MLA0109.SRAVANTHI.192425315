# 8 Queens using Backtracking

def is_safe(board, row, col):
    # Check column
    for i in range(row):
        if board[i] == col:
            return False

    # Check diagonals
    for i in range(row):
        if abs(board[i] - col) == abs(i - row):
            return False

    return True


def solve_queens(board, row):
    if row == 8:
        return True

    for col in range(8):
        if is_safe(board, row, col):
            board[row] = col

            if solve_queens(board, row + 1):
                return True

    return False


def print_board(board):
    for row in range(8):
        line = ""
        for col in range(8):
            if board[row] == col:
                line += " Q "
            else:
                line += " . "
        print(line)
    print()


board = [-1] * 8
if solve_queens(board, 0):
    print("8 Queens Solution:\n")
    print_board(board)
else:
    print("No solution found.")
