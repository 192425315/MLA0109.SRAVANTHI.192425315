import random

# -----------------------------
# Tic Tac Toe Game
# -----------------------------

def print_board(board):
    print("\nCurrent Board:")
    for row in board:
        print(" | ".join(row))
        print("-" * 9)
    print()


def check_winner(board, player):
    win_states = [
        # rows
        board[0], board[1], board[2],
        # columns
        [board[0][0], board[1][0], board[2][0]],
        [board[0][1], board[1][1], board[2][1]],
        [board[0][2], board[1][2], board[2][2]],
        # diagonals
        [board[0][0], board[1][1], board[2][2]],
        [board[0][2], board[1][1], board[2][0]]
    ]
    return [player, player, player] in win_states


def is_full(board):
    for row in board:
        if "_" in row:
            return False
    return True


def get_available_moves(board):
    moves = []
    for r in range(3):
        for c in range(3):
            if board[r][c] == "_":
                moves.append((r, c))
    return moves


# -----------------------------
# AI Logic (Simple Strategy)
# -----------------------------

def ai_move(board):
    possible_moves = get_available_moves(board)

    # 1. Check if AI can win in this move
    for r, c in possible_moves:
        board[r][c] = "O"
        if check_winner(board, "O"):
            return
        board[r][c] = "_"

    # 2. Block human win
    for r, c in possible_moves:
        board[r][c] = "X"
        if check_winner(board, "X"):
            board[r][c] = "O"
            return
        board[r][c] = "_"

    # 3. Else choose random move
    r, c = random.choice(possible_moves)
    board[r][c] = "O"


# -----------------------------
# Game Loop
# -----------------------------

def play_game():
    board = [
        ["_", "_", "_"],
        ["_", "_", "_"],
        ["_", "_", "_"]
    ]

    print("Welcome to Tic Tac Toe (Human = X, AI = O)")

    while True:
        print_board(board)

        # Human Move
        r = int(input("Enter row (0–2): "))
        c = int(input("Enter col (0–2): "))

        if board[r][c] != "_":
            print("Invalid move! Try again.")
            continue

        board[r][c] = "X"

        # Check Human Win
        if check_winner(board, "X"):
            print_board(board)
            print("🎉 Human Wins!")
            break

        if is_full(board):
            print_board(board)
            print("It's a Draw!")
            break

        # AI Move
        print("AI is making a move...")
        ai_move(board)

        # Check AI win
        if check_winner(board, "O"):
            print_board(board)
            print("🤖 AI Wins!")
            break

        if is_full(board):
            print_board(board)
            print("It's a Draw!")
            break


# -----------------------------
# Start Game
# -----------------------------
play_game()
