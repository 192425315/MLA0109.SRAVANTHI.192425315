# Knight's Tour Problem using Backtracking

# All possible knight moves
moves_x = [2, 1, -1, -2, -2, -1, 1, 2]
moves_y = [1, 2,  2,  1, -1, -2, -2, -1]


def is_safe(x, y, board, N):
    """Check if knight can move to (x, y)."""
    return 0 <= x < N and 0 <= y < N and board[x][y] == -1


def solve_knight_tour(N, start_x=0, start_y=0):
    """Solves the Knight's tour problem using Backtracking."""

    # Initialize board with -1 (unvisited)
    board = [[-1 for _ in range(N)] for _ in range(N)]

    # Starting position
    board[start_x][start_y] = 0

    # Start the recursive utility
    if not solve_util(start_x, start_y, 1, board, N):
        print("No solution exists for this board size.")
        return False
    else:
        print("Knight's Tour Path:")
        print_board(board, N)
        return True


def solve_util(x, y, move_count, board, N):
    """Recursive function to perform Knight's Tour."""

    # If all squares are visited → tour complete
    if move_count == N * N:
        return True

    # Try all 8 possible knight moves
    for i in range(8):
        next_x = x + moves_x[i]
        next_y = y + moves_y[i]

        if is_safe(next_x, next_y, board, N):
            board[next_x][next_y] = move_count

            # Recursively attempt next move
            if solve_util(next_x, next_y, move_count + 1, board, N):
                return True

            # BACKTRACK
            board[next_x][next_y] = -1

    return False


def print_board(board, N):
    for row in board:
        print(" ".join(f"{cell:2}" for cell in row))
    print()


# -------------------------
# Run the program
# -------------------------

if __name__ == "__main__":
    N = int(input("Enter board size N: "))
    start_x = int(input("Enter starting X position (0-indexed): "))
    start_y = int(input("Enter starting Y position (0-indexed): "))

    solve_knight_tour(N, start_x, start_y)
