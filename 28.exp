# 28. TSP with Ant Colony Optimization (simple version)

import random
import math

cities = [0, 1, 2, 3, 4]
dist = [
    [0, 2, 9, 10, 7],
    [2, 0, 6, 4, 3],
    [9, 6, 0, 8, 5],
    [10,4, 8, 0, 6],
    [7, 3, 5, 6, 0]
]

num_ants = 5
alpha = 1.0
beta  = 2.0
rho   = 0.5     # evaporation
Q     = 100.0
iterations = 30

n = len(cities)
tau = [[1.0 for _ in range(n)] for _ in range(n)]  # pheromone

def tour_length(tour):
    length = 0
    for i in range(len(tour)-1):
        length += dist[tour[i]][tour[i+1]]
    length += dist[tour[-1]][tour[0]]  # return to start
    return length

def choose_next_city(current, unvisited):
    probs = []
    denom = 0
    for j in unvisited:
        eta = 1.0 / dist[current][j]
        denom += (tau[current][j] ** alpha) * (eta ** beta)
    for j in unvisited:
        eta = 1.0 / dist[current][j]
        probs.append(((tau[current][j] ** alpha) * (eta ** beta)) / denom)
    r = random.random()
    cum = 0
    for city, p in zip(unvisited, probs):
        cum += p
        if r <= cum:
            return city
    return unvisited[-1]

def run_aco():
    best_tour = None
    best_len = float('inf')

    for _ in range(iterations):
        all_tours = []
        all_lengths = []

        for _ in range(num_ants):
            start = random.choice(cities)
            tour = [start]
            unvisited = [c for c in cities if c != start]
            current = start

            while unvisited:
                nxt = choose_next_city(current, unvisited)
                tour.append(nxt)
                unvisited.remove(nxt)
                current = nxt

            L = tour_length(tour)
            all_tours.append(tour)
            all_lengths.append(L)

            if L < best_len:
                best_len = L
                best_tour = tour[:]

        # (c) update pheromones
        for i in range(n):
            for j in range(n):
                tau[i][j] *= (1 - rho)

        for tour, L in zip(all_tours, all_lengths):
            for i in range(len(tour)-1):
                a, b = tour[i], tour[i+1]
                tau[a][b] += Q / L
                tau[b][a] += Q / L
            a, b = tour[-1], tour[0]
            tau[a][b] += Q / L
            tau[b][a] += Q / L

    return best_tour, best_len

if __name__ == "__main__":
    best_tour, best_len = run_aco()
    print("Best tour found:", best_tour)
    print("Best tour length:", best_len)
